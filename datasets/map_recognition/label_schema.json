{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cryptid map recognition label",
  "type": "object",
  "required": [
    "schema_version",
    "sample_id",
    "image_path",
    "image_size",
    "annotation_status",
    "board_layout",
    "tiles",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "image_path": {
      "type": "string",
      "minLength": 1
    },
    "image_size": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "annotation_status": {
      "type": "string",
      "enum": ["provisional", "verified"]
    },
    "board_layout": {
      "type": "object",
      "required": ["placements", "structure_markers"],
      "properties": {
        "placements": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["slot_id", "section_id", "orientation"],
            "properties": {
              "slot_id": { "type": "integer", "minimum": 1, "maximum": 6 },
              "section_id": { "type": "string", "enum": ["A", "B", "C", "D", "E", "F"] },
              "orientation": { "type": "string", "enum": ["normal", "flipped"] }
            },
            "additionalProperties": false
          }
        },
        "structure_markers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["section_id", "local_id", "structure_type", "structure_color"],
            "properties": {
              "section_id": { "type": "string", "enum": ["A", "B", "C", "D", "E", "F"] },
              "local_id": { "type": "integer", "minimum": 1, "maximum": 18 },
              "structure_type": { "type": "string", "enum": ["standing_stone", "abandoned_shack"] },
              "structure_color": { "type": "string", "enum": ["white", "green", "blue"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "tiles": {
      "type": "array",
      "minItems": 108,
      "maxItems": 108,
      "items": {
        "type": "object",
        "required": [
          "q",
          "r",
          "terrain",
          "section_id",
          "local_id",
          "animal",
          "structure_type",
          "structure_color",
          "tokens"
        ],
        "properties": {
          "q": { "type": "integer", "minimum": 0 },
          "r": { "type": "integer", "minimum": 0 },
          "terrain": { "type": "string", "enum": ["forest", "mountain", "water", "desert", "swamp"] },
          "section_id": { "type": "string", "enum": ["A", "B", "C", "D", "E", "F"] },
          "local_id": { "type": "integer", "minimum": 1, "maximum": 18 },
          "animal": {
            "type": ["string", "null"],
            "enum": ["bear", "cougar", null]
          },
          "structure_type": {
            "type": ["string", "null"],
            "enum": ["standing_stone", "abandoned_shack", null]
          },
          "structure_color": {
            "type": ["string", "null"],
            "enum": ["white", "green", "blue", null]
          },
          "tokens": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["player_id", "token_type"],
              "properties": {
                "player_id": { "type": "string", "minLength": 1 },
                "token_type": { "type": "string", "enum": ["cube", "round"] }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}


